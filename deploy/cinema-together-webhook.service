[Unit]
Description=CinemaTogether Telegram Bot Webhook Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cinema_together_bot
EnvironmentFile=/opt/cinema_together_bot/.env
ExecStart=/opt/cinema_together_bot/.venv/bin/uvicorn app.webhook_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
User=cinema
Group=cinema

[Install]
WantedBy=multi-user.target
