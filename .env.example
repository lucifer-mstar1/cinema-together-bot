# CinemaTogether Bot v33 deploy final config
# Local quick start uses SQLite and polling. Production can use PostgreSQL + Redis + webhook.

BOT_TOKEN=
ADMIN_IDS=YOUR_TELEGRAM_ID
# Admin access is controlled by Telegram IDs in ADMIN_IDS. Username/password are not required.
ADMIN_USERNAMES=

APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/cinema_together.log

# polling = easiest local/dev mode
# webhook = production mode behind HTTPS reverse proxy
BOT_MODE=polling
DROP_PENDING_UPDATES=true

# SQLite local:
DATABASE_URL=sqlite+aiosqlite:///./cinema_together.db
# PostgreSQL production example:
# DATABASE_URL=postgresql+asyncpg://cinema:change-me@db:5432/cinema_together
AUTO_CREATE_SCHEMA=false
# Production: set AUTO_CREATE_SCHEMA=false and run: alembic upgrade head

# Redis is required for durable FSM state and force-join cache.
REDIS_URL=redis://localhost:6379/0
# Production example:
# REDIS_URL=redis://redis:6379/0

# Webhook production settings
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-me-long-random-secret
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000

DEFAULT_LANGUAGE=uz
# Channel shown when users press Movie list. Put your real channel URL or username; leave empty until ready.
MOVIES_CHANNEL_URL=
MOVIES_CHANNEL_USERNAME=
DELETE_CLEANUP_MESSAGES=true
# Fast cleanup. false = no final message, tries to return to Telegram START screen.
CLEAN_DELETE_WINDOW=450
CLEAN_FINAL_MESSAGE=false

FREE_DAILY_SKIPS=5
PLUS_DAILY_SKIPS=25
PRO_DAILY_SKIPS=100

FREE_DAILY_MOVIE_UNLOCKS=3
PLUS_MONTHLY_MOVIE_UNLOCKS=150
PRO_DAILY_MOVIE_UNLOCKS=999
ALLOW_FREE_ROOM_JOIN=true

# Final deploy default: real Stars flow. Keep false unless you intentionally test mock admin commands locally.
MOCK_PAYMENTS=false
PLUS_1M_STARS=50
PLUS_3M_STARS=110
PLUS_6M_STARS=250
PLUS_12M_STARS=550
PRO_1M_STARS=150
PRO_3M_STARS=330
PRO_6M_STARS=750
PRO_12M_STARS=1500

# Ads frequency when users press Find Partner. Pro never sees ads.
FREE_AD_INTERVAL=2
PLUS_AD_INTERVAL=5
SAME_PAIR_REMATCH_AFTER_CHATS=1
REPORT_MATCH_AVOID_DAYS=14

# Forced join gate. If any required chat is listed below, the gate turns on
# automatically. Users must join ALL configured channels/groups before and during use.
# Admin IDs/usernames are exempt. The bot must be a member/admin of every chat.
FORCE_JOIN_ENABLED=false
# Leave these empty until you add real chats. If any required chat is listed, the gate turns on automatically.
# Public examples: FORCE_JOIN_CHATS=@main_channel,@second_channel,https://t.me/public_group
# Private example: FORCE_JOIN_GROUPS=-1001234567890|https://t.me/+REAL_INVITE_LINK|Private Group Title
# Do NOT leave placeholder/example values active.
FORCE_JOIN_CHATS=
FORCE_JOIN_CHANNELS=
FORCE_JOIN_GROUPS=
# Strict mode verifies every private update, so users who leave get blocked again.
FORCE_JOIN_STRICT=true
# Keep 0 for strict real product behavior. Increase only if you accept delayed leave detection.
FORCE_JOIN_CHECK_TTL=0
# false = strict gate. true = allow users if Telegram cannot verify a configured chat.
FORCE_JOIN_FAIL_OPEN=false

# Required groups/channels are join gates only. The bot ignores normal commands/buttons inside groups.
